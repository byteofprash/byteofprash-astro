---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Tile from "@components/Tile.astro"
import Search from "@components/Search"
import { SEARCH } from "@consts"

const posts = (await getCollection("blog")).filter((post) => !post.data.draft)
const projects = (await getCollection("projects")).filter((post) => !post.data.draft)
const data = [...posts, ...projects] as CollectionEntry<"blog">[]
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <Tile color="paper" size="lg">
    <h1 class="m-0 text-[clamp(44px,8vw,72px)] leading-[1.04]">Search</h1>
    <p class="mt-3 mb-8 text-[19px]">{SEARCH.DESCRIPTION}</p>
    <Search client:load data={data} />
  </Tile>
</PageLayout>
