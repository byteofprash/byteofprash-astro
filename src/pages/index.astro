---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Bento from "@components/Bento.astro"
import Tile from "@components/Tile.astro"
import ImageTile from "@components/ImageTile.astro"
import TerminalTile from "@components/TerminalTile.astro"
import SiteNav from "@components/SiteNav.astro"
import { SITE, SOCIALS } from "@consts"
import { FEATURED_PROJECTS } from "@data/projects"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)

const email = SOCIALS.find((s) => s.NAME === "Email")
const linkedin = SOCIALS.find((s) => s.NAME === "LinkedIn")
---

<PageLayout title="Home" description={SITE.DESCRIPTION} home>
  <Bento>
    <!-- Name -->
    <Tile color="paper" size="lg" class="c-name flex flex-col justify-between gap-4">
      <SiteNav home />
      <div>
        <div class="name-hover">
          <h1 class="name-h1 m-0 leading-none tracking-[-0.03em]" aria-label="Prash">
            <span class="name-pre" aria-hidden="true">byteof</span><span aria-hidden="true"><span class="name-cap">P</span><span class="name-low">p</span>rash</span>
          </h1>
        </div>
        <p class="mt-3 text-[14px]">Based in Munich, Germany. Currently Principal Sales Engineer at Talon.One.</p>
      </div>
    </Tile>

    <!-- Photo -->
    <ImageTile
      class="c-photo"
      color="photo"
      src="/assets/prash.jpg"
      alt="Prash smiling in a rust-orange t-shirt, with limestone hills and a sunset sky behind him"
      position="50% 42%"
      eager
    />

    <TerminalTile />

    <!-- Story -->
    <Tile color="soft" size="lg" id="story" class="c-story flex flex-col gap-3.5">
      <span class="tile-label">Story</span>
      <p class="m-0 max-w-[520px] text-[25px] leading-[1.45]">I help enterprise teams make promotions and loyalty work at scale. I love tinkering, building small useful things, and writing about what I learn.</p>
      <a href="/story" class="link mt-auto text-[18px]">Read my story →</a>
    </Tile>

    <!-- Painting -->
    <ImageTile
      class="c-tan"
      color="sky"
      src="/assets/scroll.jpg"
      alt="Ink wash painting of a misty mountain with a small village and pine trees"
      position="50% 60%"
    />

    <!-- Projects -->
    <div class="c-proj flex flex-col gap-5 min-h-0">
      <Tile color="gold" href="/projects" class="flex flex-1 basis-0 flex-col justify-between gap-3">
        <span class="tile-label">Select projects</span>
        <span class="display text-[34px] font-semibold leading-[1.1]">Things I built →</span>
      </Tile>
      <div class="flex flex-1 basis-0 gap-5">
        {FEATURED_PROJECTS.map((p) => (
          <Tile color="gold" size="sm" href={`/projects/${p.slug}`} class="flex flex-1 basis-0 flex-col justify-between gap-2">
            <span class="text-sm">Project</span>
            <span class="display text-[22px] font-semibold leading-[1.15]">{p.title} →</span>
          </Tile>
        ))}
      </div>
    </div>

    <!-- Writing -->
    <Tile color="warm" id="writing" class="c-write flex flex-col gap-3.5">
      <span class="tile-label">Latest writing</span>
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="display text-2xl font-medium leading-[1.2]">{post.data.title} →</a>
      ))}
      <a href="/blog" class="link mt-auto text-[17px]">All writing →</a>
    </Tile>

    <!-- Contact -->
    <Tile color="deep" id="contact" class="c-contact flex flex-col justify-between gap-3">
      <span class="tile-label">Contact</span>
      <div>
        {email && <a href={email.HREF} class="display text-[44px] font-medium leading-[1.1]">Say hello →</a>}
        {linkedin && (
          <div class="mt-3.5">
            <a href={linkedin.HREF} target="_blank" rel="noopener noreferrer" class="link text-[17px]">LinkedIn ↗</a>
          </div>
        )}
      </div>
    </Tile>
  </Bento>
</PageLayout>
