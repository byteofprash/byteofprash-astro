---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Tile from "@components/Tile.astro"
import { WORK } from "@consts"

const collection = await getCollection("work")
collection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  }),
)

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return input
  const month = input.toLocaleDateString("en-US", { month: "short" })
  return `${month} ${new Date(input).getFullYear()}`
}
const colors = ["soft", "paper"] as const
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Tile color="paper" size="lg">
    <h1 class="m-0 text-[clamp(44px,8vw,72px)] leading-[1.04]">Work</h1>
    <p class="mt-3 text-[19px]">{WORK.DESCRIPTION}</p>
  </Tile>
  {work.map((entry, i) => (
    <Tile color={colors[i % 2]} size="lg">
      <div class="mono text-[13px] text-muted">{formatWorkDate(entry.data.dateStart)} – {formatWorkDate(entry.data.dateEnd)}</div>
      <h2 class="mt-3 mb-0 text-[34px] leading-[1.1]">{entry.data.company}</h2>
      <div class="mt-1 text-[17px] font-medium">{entry.data.role}</div>
      <article class="post mt-4"><entry.Content /></article>
    </Tile>
  ))}
</PageLayout>
