---
import PageLayout from "@layouts/PageLayout.astro"
import Tile from "@components/Tile.astro"
import { PHOTOGRAPHY } from "@consts"

const portraits = [
  "/images/2024/11/DSC_1541_rickcork.jpg",
  "/images/2024/11/DSC_1566_BW.jpg",
  "/images/2024/11/DSC_0656.jpg",
  "/images/2024/11/DSC_9624.JPG",
]

const iceland = [
  "/images/2024/12/DSC_6388.JPG",
  "/images/2024/12/DSC_6421.JPG",
  "/images/2024/12/DSC_6507.JPG",
  "/images/2024/12/DSC_6662.JPG",
  "/images/2024/12/DSC_6835.JPG",
  "/images/2024/12/DSC_7067.JPG",
]

---

<PageLayout title={PHOTOGRAPHY.TITLE} description={PHOTOGRAPHY.DESCRIPTION}>
  <Tile color="paper" size="lg">
    <h1 class="m-0 text-[clamp(44px,8vw,72px)] leading-[1.04]">Photography</h1>
    <p class="mt-3 text-[19px]">{PHOTOGRAPHY.DESCRIPTION}</p>
  </Tile>

  <Tile color="soft" size="lg">
    <h2 class="m-0 mb-5 text-[34px] leading-[1.1]">Portraits</h2>
    <div class="grid grid-cols-2 gap-5">
      {portraits.map((src) => (
        <img src={src} alt="Portrait photograph" loading="lazy" decoding="async" class="h-64 w-full rounded-tile object-cover md:h-80" />
      ))}
    </div>
  </Tile>

  <Tile color="sky" size="lg">
    <h2 class="m-0 mb-5 text-[34px] leading-[1.1]">Iceland</h2>
    <div class="grid grid-cols-2 gap-5 md:grid-cols-3">
      {iceland.map((src) => (
        <img src={src} alt="Landscape photograph from Iceland" loading="lazy" decoding="async" class="h-48 w-full rounded-tile object-cover md:h-64" />
      ))}
    </div>
  </Tile>
</PageLayout>
