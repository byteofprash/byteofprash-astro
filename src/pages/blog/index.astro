---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Tile from "@components/Tile.astro"
import { BLOG } from "@consts"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const fmt = (d: Date) =>
  Intl.DateTimeFormat("en-US", { month: "short", day: "2-digit", year: "numeric" }).format(d)
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Tile color="paper" size="lg">
    <h1 class="m-0 text-[clamp(44px,8vw,72px)] leading-[1.04]">Writing</h1>
    <p class="mt-3 text-[19px]">{BLOG.DESCRIPTION}</p>
    <ul class="mt-8 list-none p-0">
      {posts.map((post) => (
        <li class="border-t border-soft first:border-t-0">
          <a href={`/blog/${post.slug}`} class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 hover:underline underline-offset-4">
            <span class="display text-2xl font-medium leading-[1.2]">{post.data.title}</span>
            <time class="mono text-[13px] text-muted" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </a>
        </li>
      ))}
    </ul>
  </Tile>
</PageLayout>
