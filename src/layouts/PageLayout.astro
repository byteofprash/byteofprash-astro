---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import SiteNav from "@components/SiteNav.astro"
import KolamBorder from "@components/KolamBorder.astro"
import SiteFooter from "@components/SiteFooter.astro"
import { SITE } from "@consts"

type Props = { title: string; description: string; home?: boolean; image?: string }
const { title, description, home = false, image } = Astro.props
const fullTitle = home ? `${SITE.TITLE}` : `${title} | ${SITE.TITLE}`
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} />
  </head>
  <body>
    <div class="page">
      {!home && <SiteNav />}
      <main class="flex flex-col gap-5">
        <slot />
      </main>
      <div class="flex flex-col gap-5">
        <KolamBorder />
        <SiteFooter />
      </div>
    </div>
  </body>
</html>
